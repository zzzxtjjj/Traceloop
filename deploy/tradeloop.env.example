# Copy to a root-owned environment file outside the repository.
TRADELOOP_DATA_DIR=/var/lib/tradeloop/data
TRADELOOP_UPLOAD_DIR=/var/lib/tradeloop/uploads
DATABASE_URL=sqlite:////var/lib/tradeloop/data/tradeloop.db
MODEL_API_KEY=
MODEL_NAME=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_INPUT_CHARS=50000
MODEL_MAX_REVIEWS_PER_RUN=200
MODEL_MAX_ATTEMPTS=1
TESSERACT_CMD=/usr/bin/tesseract
TRADELOOP_OCR_LANGUAGES=eng+deu+chi_sim
